<svg xmlns="http://www.w3.org/2000/svg" width="900" height="1200" viewBox="0 0 900 1200">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fff0e8"/>
      <stop offset="50%" stop-color="#fff8f9"/>
      <stop offset="100%" stop-color="#fce7ec"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#e2847a" stop-opacity="0.1"/>
    </radialGradient>
    <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="30" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="900" height="1200" fill="url(#bg)" />

  <!-- Soft background circle -->
  <circle cx="450" cy="500" r="320" fill="url(#glow)" />
  <circle cx="450" cy="500" r="280" fill="none" stroke="#e2847a" stroke-width="2" stroke-dasharray="6,8" opacity="0.4" />
  <circle cx="450" cy="500" r="250" fill="none" stroke="#e2847a" stroke-width="1" opacity="0.6" />

  <!-- Botanical corner touches -->
  <g fill="#e2847a" opacity="0.25">
    <circle cx="120" cy="120" r="16" />
    <circle cx="150" cy="100" r="10" />
    <circle cx="100" cy="150" r="10" />
    <path d="M 120 120 Q 200 130 250 200 Q 180 230 120 120 Z" />
    
    <circle cx="780" cy="1080" r="16" />
    <circle cx="750" cy="1100" r="10" />
    <circle cx="800" cy="1050" r="10" />
    <path d="M 780 1080 Q 700 1070 650 1000 Q 720 970 780 1080 Z" />
  </g>

  <!-- Central Silhouette / Aesthetic Icon Portrait Frame -->
  <g transform="translate(450, 480)">
    <!-- Elegant portrait silhouette frame -->
    <ellipse cx="0" cy="0" rx="170" ry="210" fill="#ffffff" opacity="0.75" />
    <ellipse cx="0" cy="0" rx="160" ry="200" fill="none" stroke="#e2847a" stroke-width="2" opacity="0.8" />
    
    <!-- Central Icon/Symbol -->
    <text x="0" y="-10" font-size="80" text-anchor="middle" dominant-baseline="central">✨</text>
    
    <!-- Little Sparkles -->
    <text x="-100" y="-110" font-size="28" fill="#e2847a" text-anchor="middle">✦</text>
    <text x="110" y="-80" font-size="34" fill="#e2847a" text-anchor="middle">✧</text>
    <text x="-90" y="100" font-size="30" fill="#e2847a" text-anchor="middle">✧</text>
    <text x="90" y="90" font-size="26" fill="#e2847a" text-anchor="middle">✦</text>
  </g>

  <!-- Typography Card overlay -->
  <g transform="translate(450, 840)">
    <rect x="-320" y="0" width="640" height="220" rx="28" fill="#ffffff" opacity="0.88" />
    <rect x="-320" y="0" width="640" height="220" rx="28" fill="none" stroke="#e2847a" stroke-width="1.5" opacity="0.4" />
    
    <text x="0" y="55" font-family="'Playfair Display', Georgia, serif" font-size="36" font-weight="600" fill="#4a2e35" text-anchor="middle">
      Radiant Smile
    </text>
    <text x="0" y="98" font-family="'Plus Jakarta Sans', sans-serif" font-size="20" font-weight="400" fill="#8e5d6d" text-anchor="middle">
      Lighting up every room
    </text>
    <text x="0" y="145" font-family="'Dancing Script', cursive" font-size="24" fill="#e2847a" text-anchor="middle">
      photo slot: /assets/images/friend-portrait-1.jpg
    </text>
    <text x="0" y="180" font-family="'Plus Jakarta Sans', sans-serif" font-size="15" fill="#a07d88" text-anchor="middle">
      (Click &quot;Customize Photos&quot; to upload her real photo directly!)
    </text>
  </g>
</svg>